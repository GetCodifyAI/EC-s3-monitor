{
  "_comment": "REFERENCE ONLY. Terraform creates this inline policy on the Lambda execution role (aws_iam_role_policy.lambda + .webhook_ssm). Reproduced here so a reviewer can see the runtime blast radius without reading HCL. Do not attach by hand.",
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListMonitoredPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::cut-dry-vendor-integration",
      "Condition": {
        "StringLike": { "s3:prefix": "enterprise-cafe/prod/incoming/purchase-orders/*" }
      }
    },
    {
      "Sid": "MonitorState",
      "Effect": "Allow",
      "Action": ["dynamodb:GetItem", "dynamodb:PutItem"],
      "Resource": "arn:aws:dynamodb:us-east-2:057311931122:table/s3-feed-monitor-enterprise-cafe-po-prod-state"
    },
    {
      "Sid": "PublishMetrics",
      "Effect": "Allow",
      "Action": "cloudwatch:PutMetricData",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "cloudwatch:namespace": "CutAndDry/FeedFreshness" }
      }
    },
    {
      "Sid": "Logs",
      "Effect": "Allow",
      "Action": ["logs:CreateLogStream", "logs:PutLogEvents"],
      "Resource": "arn:aws:logs:us-east-2:057311931122:log-group:/aws/lambda/s3-feed-monitor-enterprise-cafe-po-prod:*"
    },
    {
      "Sid": "ReadSlackBotToken",
      "Effect": "Allow",
      "Action": "ssm:GetParameter",
      "Resource": "arn:aws:ssm:us-east-2:057311931122:parameter/s3-feed-monitor-enterprise-cafe-po-prod/slack-bot-token"
    },
    {
      "Sid": "DecryptSecureStringViaSsm",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "*",
      "Condition": {
        "StringEquals": { "kms:ViaService": "ssm.us-east-2.amazonaws.com" }
      }
    }
  ]
}
