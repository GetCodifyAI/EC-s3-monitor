# Cut+Dry Eng / non-prod - account 147723036280, us-east-2 only.
#
#   aws sso login --profile non-prod-sso
#   ./deploy.sh nonprod          # dry run
#   ./deploy.sh nonprod false    # live
#
# Every value here is a CloudFormation parameter. Changing what is watched, how
# stale is stale, or where the alert goes is an edit to this file and a redeploy
# - never a code change.

ACCOUNT=147723036280
REGION=us-east-2
PROFILE=non-prod-sso
STACK=s3-staleness-monitor

# Holds the packaged Lambda zip. deploy.sh creates it if it does not exist.
ARTIFACT_BUCKET=s3-staleness-monitor-artifacts-147723036280

# The location this monitor exists for.
MONITORED_BUCKET=cut-and-dry-test
# Keep this on one line with no spaces inside the JSON. It is passed through
# `cloudformation deploy --parameter-overrides`, which splits pairs on spaces.
FEEDS_JSON='[{"id":"test-dev","prefix":"test-dev/"}]'

# Incoming webhook for #slack-test, held as a SecureString in this account.
# RUNBOOK.md step 2 creates it. The URL is a secret - it is a bearer token for
# posting to the channel - so it never appears in this file or in the template.
SLACK_WEBHOOK_PARAM=/platform-monitors/s3-staleness/slack-test-webhook

# Three consecutive calendar days, as asked. BUSINESS_DAYS_ONLY=false means a
# Friday delivery does read as stale on Monday; flip it to true if that turns
# out to be noise.
STALE_DAYS=3
BUSINESS_DAYS_ONLY=false

# Empty counts every non-empty object. Set to e.g. ".csv" if a stray .tmp or
# _SUCCESS marker in the prefix should not reset the clock.
OBJECT_SUFFIX=

DISPLAY_TZ=America/Los_Angeles
SCHEDULE_EXPRESSION='cron(0 15 * * ? *)'   # 08:00 PT, once a day
LOG_RETENTION_DAYS=30

# No SNS topic confirmed in this account yet, so no health alarm is created.
# See "What is still unconfirmed" in RUNBOOK.md - this is the gap that matters.
ALARM_TOPIC_ARN=
