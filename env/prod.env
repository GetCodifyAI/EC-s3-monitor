# PRODUCTION - account 057311931122, us-east-2.
#
# Watches the real Enterprise Cafe purchase-order feed. Nothing in this file may
# be pointed at a scratch bucket or a test prefix.
#
# Platform deploys this. See PROD-HANDOVER.md for the sequence - there are two
# prerequisites in this account before ./deploy.sh prod will work at all.

ACCOUNT=057311931122
REGION=us-east-2
STACK=s3-staleness-monitor

# deploy.sh creates this if it does not exist.
ARTIFACT_BUCKET=s3-staleness-monitor-artifacts-057311931122

# Left empty deliberately: whoever deploys this uses their own credentials, and
# hardcoding a profile name here would only be wrong for them. The account guard
# in deploy.sh still runs and still refuses anything that is not 057311931122,
# so an empty profile cannot cause a cross-account deploy.
PROFILE=

MONITORED_BUCKET=cut-dry-vendor-integration
FEEDS_JSON='[{"id":"enterprise-cafe/purchase-orders","prefix":"enterprise-cafe/prod/incoming/purchase-orders/"}]'

# Must exist as a SecureString in THIS account before deploying. The non-prod
# parameter is in 147723036280 and is not visible from here.
SLACK_WEBHOOK_PARAM=/platform-monitors/s3-staleness/dam-alerts-webhook

# Three BUSINESS days. A Friday delivery must not read as stale on Monday
# morning, which is what BUSINESS_DAYS_ONLY=false would do for any feed that
# follows a business calendar.
STALE_DAYS=3
BUSINESS_DAYS_ONLY=true

# PO files are CSV. Filtering means a stray .tmp, a _SUCCESS marker or a
# partial upload cannot reset the staleness clock and hide a dead feed.
OBJECT_SUFFIX=.csv

DISPLAY_TZ=America/Los_Angeles
SCHEDULE_EXPRESSION='cron(0 15 * * ? *)'   # 08:00 PT, once a day
LOG_RETENTION_DAYS=30

# Should NOT stay empty in production. With no topic, nothing watches the
# monitor, and a crashed Lambda is indistinguishable from a healthy feed -
# both are silence. See PROD-HANDOVER.md.
ALARM_TOPIC_ARN=
