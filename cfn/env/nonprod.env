# Cut+Dry Eng / non-prod - account 147723036280, us-east-2 only.
# Sign in with:  aws sso login --profile non-prod-sso
#
# The vendor bucket lives in PROD and is not readable from this account, so
# non-prod watches a scratch bucket this repo creates instead. That still
# exercises everything except the prod feed itself: the schedule, the watermark,
# the business-day maths, the message text and the Slack post.
ACCOUNT=147723036280
REGION=us-east-2
STACK=s3-feed-freshness-nonprod
ARTIFACT_BUCKET=s3-feed-freshness-artifacts-147723036280

MONITORED_BUCKET=s3-feed-freshness-testfeed-147723036280
FEEDS_JSON='[{"id":"test/purchase-orders","prefix":"test/incoming/purchase-orders/"}]'

# Incoming webhook for #slack-test, stored as a SecureString in this account.
SLACK_WEBHOOK_PARAM=/platform-monitors/s3-feed-freshness/slack-test-webhook

# An empty prefix reads as "no files ever" and alerts immediately; one dropped
# file clears it. That is the whole transition test, with no waiting.
STALE_DAYS=1
BUSINESS_DAYS_ONLY=true
RENOTIFY_HOURS=0                           # one alert per outage, not every 30 min
SCHEDULE_EXPRESSION='rate(30 minutes)'     # fast feedback while testing
ALARM_TOPIC_ARN=
